<UserControl x:Class="SmartRenamer.Controls.ConversationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="RoundedSendButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource ConversationHeaderTextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource ConversationSendBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource ConversationSendBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource ConversationSendHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource ConversationSendPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <Border Margin="8"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource ConversationBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="60"/>

                </Grid.RowDefinitions>

                <!-- Conversation Header -->

                <Border Grid.Row="0"
                        Background="{StaticResource ConversationHeaderBrush}"
                        CornerRadius="24,24,0,0"
                        Padding="18">

                    <StackPanel>

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource ConversationHeaderTextBrush}"
                            Text="Scout"/>

                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource ConversationSubtitleBrush}"
                            Text="Helping you Navigate your FILE Safari"/>

                    </StackPanel>

                </Border>

                <!-- Conversation Messages -->

                <ListBox
                    x:Name="ConversationList"
                    Grid.Row="1"
                    Margin="10"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemsSource="{Binding Conversation.Messages}">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="0,0,0,6">

                                <!-- Text Message -->

                                <Border
                                    Padding="10"
                                    Background="{StaticResource ConversationBubbleBrush}"
                                    CornerRadius="12">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Text}"
                                                             Value="">

                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap"/>

                                </Border>

                                <!-- Rich Card -->

                                <ContentPresenter
                                    Margin="0,10,0,0"
                                    Content="{Binding Card}" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- Conversation Input -->

                <Border Grid.Row="2"
                        Background="{StaticResource ConversationInputBrush}"
                        BorderBrush="{StaticResource ConversationBorderBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="10">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="72"/>

                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="InputBox"
                            Grid.Column="0"
                            Height="36"
                            Padding="8"
                            VerticalContentAlignment="Center"
                            AcceptsReturn="False"
                            TextWrapping="NoWrap"
                            KeyDown="InputBox_KeyDown"
                            Text="{Binding UserInput,
                                           UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            x:Name="SendButton"
                            Grid.Column="2"
                            Width="68"
                            Height="32"
                            VerticalAlignment="Center"
                            Content="Send"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource RoundedSendButton}"/>
                            

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>