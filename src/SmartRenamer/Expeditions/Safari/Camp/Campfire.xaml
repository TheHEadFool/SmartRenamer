<UserControl x:Class="Scout.Expeditions.Safari.Camp.CampFire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xgif="clr-namespace:XamlAnimatedGif;assembly=XamlAnimatedGif"
             Width="120"
             Height="120">

    <Grid ClipToBounds="False">

                     
        <!-- Stone Ring -->
        <!-- <Image Source="/Expeditions/Safari/Assets/Fire3/StoneRing.png"
               Stretch="Uniform"
               IsHitTestVisible="False"/>-->

        <!-- Logs -->
        <!-- <Image x:Name="Logs"
               Source="/Expeditions/Safari/Assets/Fire3/Logs.png"
               Stretch="Uniform"
               IsHitTestVisible="False"/>-->

        <!-- Animated Fire -->
        <Ellipse x:Name="FireGlow"
         Width="95"
         Height="110"
         Fill="#80FFB040"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"
         Margin="0,-35,0,0"
         Opacity="0.28"
         IsHitTestVisible="False"
         RenderTransformOrigin="0.5,0.5">

            <Ellipse.RenderTransform>
                <ScaleTransform/>
            </Ellipse.RenderTransform>

            <Ellipse.Effect>
                <BlurEffect Radius="28"/>
            </Ellipse.Effect>

            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">

                            <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="0.18"
                        To="0.36"
                        Duration="0:0:2.2"/>

                            <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                        From="0.90"
                        To="1.12"
                        Duration="0:0:2.6"/>

                            <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                        From="0.90"
                        To="1.08"
                        Duration="0:0:2.4"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>

        </Ellipse>
        <Image x:Name="Flame"
       Width="130"
       Height="100"
       Stretch="Uniform"
       Margin="0,-35,0,0"
       VerticalAlignment="Center"
       HorizontalAlignment="Center"
       RenderTransformOrigin="0.5,1"
       xgif:AnimationBehavior.SourceUri="/Expeditions/Safari/Assets/Fire3/FireSlow.gif"/>

        <!-- Smoke (future) -->
        <Canvas x:Name="SmokeLayer"
        Width="160"
        Height="180"
        Margin="0,-65,0,0"
        IsHitTestVisible="False"/>

    </Grid>

</UserControl>