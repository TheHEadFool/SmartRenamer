<UserControl x:Class="Scout.Expeditions.Safari.Components.SafariHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Scout.Expeditions.Safari.Components"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="800"
             Height="220">

    <Border CornerRadius="18"
            ClipToBounds="True"
            HorizontalAlignment="Stretch">

        <Grid>

            <!-- Safari Stage -->
            <Viewbox Stretch="Fill">

                <components:SafariStage />

            </Viewbox>

            <!-- Overlay -->
            <Grid Margin="24">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left side -->
                <StackPanel VerticalAlignment="Top">

                    <Image Source="/Expeditions/Safari/Assets/ScoutSign.png"
                           Width="160"
                           Stretch="Uniform"
                           HorizontalAlignment="Left" />

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding HeaderTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Left" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding HeaderSubtitle}"
                               FontSize="13"
                               Foreground="#D8C38A"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               HorizontalAlignment="Left" />

                </StackPanel>

                <!-- Reserved center area -->
                <Grid Grid.Column="1">

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               Foreground="#D8C38A"
                               Text="" />

                </Grid>

            </Grid>

        </Grid>

    </Border>

</UserControl>