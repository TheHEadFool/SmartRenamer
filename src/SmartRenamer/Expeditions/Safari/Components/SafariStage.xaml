<UserControl x:Class="Scout.Expeditions.Safari.Components.SafariStage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:camp="clr-namespace:Scout.Expeditions.Safari.Camp"
             xmlns:actors="clr-namespace:Scout.Expeditions.Safari.Actors"
             mc:Ignorable="d"
             Width="1600"
             Height="220">

    <Grid Width="1600"
      Height="220">

        <!-- Background -->
        <Image Source="/Expeditions/Safari/Assets/images/HeaderBackground.png"
           Stretch="Fill"/>

        <!-- Waterfall Effects -->
        <Canvas x:Name="WaterfallLayer"
            Width="1600"
            Height="220"
            Background="Transparent"
            IsHitTestVisible="False"/>

        <!-- Actors -->
        <Canvas x:Name="ActorLayer"
            Width="1600"
            Height="220"
            Background="Transparent">

            <camp:CampFire
        x:Name="CampFireActor"
        Width="155"
        Height="182"
        Canvas.Left="1178"
        Canvas.Top="92"
        RenderTransformOrigin="0.5,0.315"/>

            <actors:Tent
    Width="240"
    Height="240"
    Canvas.Left="1280"
    Canvas.Top="0"/>

            <actors:Files
    Width="90"
    Height="90"
    Canvas.Left="165"
    Canvas.Top="105"/>

        </Canvas>

    </Grid>

</UserControl>