    <Window x:Class="SmartRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartRenamer.Controls"
        xmlns:expedition="clr-namespace:Scout.Controls"
        Title="Scout"
        Width="1650"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- Expedition Header                                         -->
        <!-- ========================================================= -->

        <expedition:ExpeditionHeaderHost
            Grid.Row="0"/>

        <!-- ========================================================= -->
        <!-- Main Scout Workspace                                      -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="270"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="560"/>

            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- Scout Observations -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
        Style="{StaticResource CardBorder}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="15">

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Scout title and description -->
                            <StackPanel Grid.Column="0"
                VerticalAlignment="Center">

                                <TextBlock
            FontSize="22"
            FontWeight="Bold"
            Text="Scout"/>

                                <TextBlock
            Margin="0,6,8,0"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="Choose an observation to explore."
            TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Review All -->
                            <!-- Review All -->
                            <Button
    Grid.Column="1"
    Width="96"
    Height="96"
    Margin="8,0,0,0"
    Padding="0"
    BorderThickness="0"
    Background="Transparent"
    ToolTip="Review All"
    Cursor="Hand"                           
    Command="{Binding DataContext.Workspace.ReviewAllCommand,
                      RelativeSource={RelativeSource AncestorType=Window}}">

                                <Image
        Source="/Expeditions/Safari/Assets/images/ReviewAll.png"
        Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <Border
                Padding="16"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="#F8FAFD">

                            <StackPanel>

                                <!--
    ================================================================
    BUTTON PRESENTATION PATH
    ================================================================

    These buttons are driven by ProjectObservation.

    The same ExpertFinding also feeds the Conversation Framework.

    ExpertFinding
        |
        + ProjectObservation = Button Path
        |
        + CV_Recommendation = Conversation Path

    The two presentation paths intentionally remain independent.

    The button path lets the user choose an observation.
    The conversation path lets Scout discuss its recommendation.
    ================================================================
                -->

                                <ItemsControl ItemsSource="{Binding Workspace.Observations}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                Margin="0,0,0,10"
                Padding="8"
                CornerRadius="8"
                Background="{StaticResource ObservationSurfaceBrush}">

                                                <StackPanel>

                                                   

                                                        <Border
    Margin="0,0,0,0"
    Padding="8"
    Background="{StaticResource ObservationCardBrush}"
    BorderBrush="{StaticResource ObservationBorderBrush}"
    BorderThickness="1"
    CornerRadius="10">

                                                            <Button
            Style="{StaticResource ObservationButtonStyle}"
            Padding="10,8"
            MinHeight="48"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Command="{Binding DataContext.Workspace.SelectObservationCommand,
                RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}">

                                                                <TextBlock
                Text="{Binding ActionTitle}"
                TextWrapping="Wrap"
                TextAlignment="Left"
                FontSize="12"
                HorizontalAlignment="Stretch"/>

                                                            </Button>

                                                        </Border>

                                                    
                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                                                
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>
            <!-- ================================================= -->
            <!-- Workspace -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- Workspace -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
        Margin="20,0"
        Style="{StaticResource CardBorder}">

                <Grid Margin="25">

                    <!-- ================================================= -->
                    <!-- NORMAL MODE -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger
                            Binding="{Binding Workspace.IsReviewAllActive}"
                            Value="True">
                                        <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                Grid.Row="0"
                FontSize="30"
                FontWeight="Bold"
                Text="Scout's Recommendation"/>

                        <StackPanel Grid.Row="3">

                            <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Supporting Evidence"/>

                            <Border
                    Margin="0,10,0,0"
                    Padding="12"
                    Background="#EEF5FF"
                    CornerRadius="10">

                                <StackPanel>

                                    <TextBlock
                            Text="{Binding Workspace.SelectedObservation.Description}"
                            TextWrapping="Wrap"
                            FontSize="13"
                            Margin="0,0,0,12"/>

                                    <TextBlock
                            Text="{Binding Workspace.SelectedObservation.WhyItMatters}"
                            TextWrapping="Wrap"
                            FontSize="13"
                            Margin="0,0,0,12"/>

                                    <TextBlock
                            Text="{Binding Workspace.SelectedObservation.ActionTitle}"
                            FontWeight="SemiBold"
                            FontSize="14"
                            TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                        <Grid Grid.Row="5">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel
                    Grid.Row="0"
                    LastChildFill="False">

                                <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Rename Preview"/>

                                <Border
                        Margin="10,0,0,0"
                        Padding="8,2"
                        Background="#D9EEF8"
                        CornerRadius="10"
                        DockPanel.Dock="Right">

                                    <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Workspace.RenameCount,
                                   StringFormat={}{0} file(s)}"/>

                                </Border>

                            </DockPanel>

                            <Border
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    CornerRadius="8">

                                <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ItemsSource="{Binding Workspace.RenamePreview}">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn
                                Header="Current Name"
                                Width="*"
                                Binding="{Binding CurrentName}"/>

                                        <DataGridTextColumn
                                Header="New Name"
                                Width="*"
                                Binding="{Binding NewName}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Border>

                        </Grid>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- REVIEW ALL MODE -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger
                            Binding="{Binding Workspace.IsReviewAllActive}"
                            Value="True">
                                        <Setter Property="Visibility"
                                    Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Review All heading -->

                        <TextBlock
                Grid.Row="0"
                FontSize="30"
                FontWeight="Bold"
                Text="Scout's Review All"/>


                        <!-- Introduction -->

                        <Border
                Grid.Row="2"
                Padding="15"
                Background="#EEF5FF"
                CornerRadius="10">

                            <StackPanel>

                                <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Recommendations"/>

                                <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Text="Scout reviewed the discoveries and recommendations from this scan. Nothing will be changed until you choose an action."/>

                                <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding Workspace.ReviewAllItems.Count,
                               StringFormat={}Recommendations found: {0}}"/>

                            </StackPanel>

                        </Border>


                        <!-- Recommendation list -->

                        <Border
                Grid.Row="3"
                Margin="0,15,0,0"
                BorderBrush="#D8D8D8"
                BorderThickness="1"
                CornerRadius="8">

                            <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl
                        ItemsSource="{Binding Workspace.ReviewAllItems}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                    Margin="10"
                                    Padding="15"
                                    Background="#F8FAFD"
                                    BorderBrush="#D8D8D8"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                                <StackPanel>

                                                    <Button
    Padding="0"
    HorizontalContentAlignment="Left"
    Background="Transparent"
    BorderThickness="0"
    Cursor="Hand"
    Command="{Binding DataContext.Workspace.SelectReviewAllItemCommand,
                      RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}">

                                                        <TextBlock
        FontSize="18"
        FontWeight="SemiBold"
        Foreground="#245A35"
        Text="{Binding Recommendation.Title}"
        TextWrapping="Wrap"/>

                                                    </Button>

                                                    <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="13"
                                            Text="{Binding Recommendation.Reason}"
                                            TextWrapping="Wrap"/>

                                                    <ItemsControl
                                            Margin="0,10,0,0"
                                            ItemsSource="{Binding Recommendation.Evidence}">

                                                        <ItemsControl.ItemTemplate>

                                                            <DataTemplate>

                                                                <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="12"
                                                        Text="{Binding}"
                                                        TextWrapping="Wrap"/>

                                                            </DataTemplate>

                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Border>

                    </Grid>

                </Grid>

            </Border>
            <!-- ================================================= -->
            <!-- Scout -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
        Style="{StaticResource CardBorder}">

                <controls:ConversationPanel
DataContext="{Binding Guide}"/>

            </Border>

        </Grid>

        <!-- Status -->

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="12"
                CornerRadius="10"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">

            <DockPanel>

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Ready"/>

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Version 0.5 Development"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>