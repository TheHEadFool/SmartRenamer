<Window x:Class="SmartRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartRenamer.Controls"
        xmlns:expedition="clr-namespace:Scout.Controls"
        Title="Scout"
        Width="1650"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- Expedition Header                                         -->
        <!-- ========================================================= -->

        <expedition:ExpeditionHeaderHost
            Grid.Row="0"/>

        <!-- ========================================================= -->
        <!-- Scout Operation Progress                                  -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="1"
            Margin="0,6,0,6"
            Padding="8"
            CornerRadius="10"
            Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="{Binding Operation.Status}"
                        FontWeight="SemiBold"
                        FontSize="9"/>

                    <ProgressBar
                        Margin="0,4,0,3"
                        Height="7"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Operation.PercentComplete, Mode=OneWay}"/>

                    <TextBlock
                        Text="{Binding Operation.CurrentTask}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="11"/>

                    <TextBlock
                        Margin="0,1,0,0"
                        Text="{Binding Operation.CurrentFile}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="9"
                        TextTrimming="CharacterEllipsis"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                    <ToggleButton
                        Margin="0,0,0,2"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Guide.AutomaticRepairsEnabled, Mode=OneWay}"
                        Command="{Binding Guide.ToggleAutomaticRepairsCommand}"
                        ToolTip="Allow Scout to perform repairs that meet its existing automatic-repair safety rules. Ambiguous repairs still require you."
                        Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="Automatic Repairs: OFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Guide.AutomaticRepairsEnabled}" Value="True">
                                        <Setter Property="Content" Value="Automatic Repairs: ON"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <TextBlock
                        Text="{Binding Operation.PercentComplete, StringFormat={}{0}%}"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"/>

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,1,0,0">

                        <TextBlock
                            Margin="0,0,8,0"
                            Text="{Binding Operation.CollectionTotal, StringFormat={}{0} ebooks}"
                            FontSize="9"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock
                            Margin="0,0,8,0"
                            Text="{Binding Operation.CollectionCompleted, StringFormat=Completed {0}}"
                            FontSize="9"/>

                        <TextBlock
                            Margin="0,0,8,0"
                            Text="{Binding Operation.CollectionProcessing, StringFormat=Processing {0}}"
                            FontSize="9"/>

                        <TextBlock
                            Margin="0,0,8,0"
                            Text="{Binding Operation.CollectionWaiting, StringFormat=Waiting {0}}"
                            FontSize="9"/>

                        <TextBlock
                            Text="{Binding Operation.CollectionPending, StringFormat=Pending {0}}"
                            FontSize="9"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- Main Scout Workspace                                      -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="270"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="560"/>

            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- Scout Observations -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
        Style="{StaticResource CardBorder}">

                <!--
                    The left pane has two different jobs:

                    1. Observations are a browseable list and may need to scroll.
                    2. Scout Controls are the current actions and must remain
                       visible without requiring the user to discover a second
                       scrollbar.

                    Keep those surfaces in separate Grid rows.  The old layout
                    put both inside one ScrollViewer, which allowed a long
                    observation list to push the actual decision buttons below
                    the visible window.
                -->
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header / Review All -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Text="Scout"/>

                            <TextBlock
                                Margin="0,6,8,0"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="Choose an observation to explore."
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Width="96"
                            Height="96"
                            Margin="8,0,0,0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Review All"
                            Cursor="Hand"
                            Command="{Binding DataContext.Workspace.ReviewAllCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image
                                Source="/Expeditions/Safari/Assets/images/ReviewAll.png"
                                Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Observation list: this is the only scrollable part. -->
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <Border
                            Padding="16"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="#F8FAFD">

                            <ItemsControl ItemsSource="{Binding Workspace.Observations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="8"
                                            CornerRadius="8"
                                            Background="{StaticResource ObservationSurfaceBrush}">
                                            <Border
                                                Padding="8"
                                                Background="{StaticResource ObservationCardBrush}"
                                                BorderBrush="{StaticResource ObservationBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Button
                                                    Style="{StaticResource ObservationButtonStyle}"
                                                    Padding="10,8"
                                                    MinHeight="48"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.Workspace.SelectObservationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                    <TextBlock
                                                        Text="{Binding ActionTitle}"
                                                        TextWrapping="Wrap"
                                                        TextAlignment="Left"
                                                        FontSize="12"
                                                        HorizontalAlignment="Stretch"/>
                                                </Button>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>

                    <!--
                        Current decision/action surface.  This stays pinned to
                        the bottom of the left pane.  It is deliberately not
                        inside the observation ScrollViewer.
                    -->
                    <Border
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Guide.HasScoutControls}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock
                                Text="Scout Controls"
                                FontWeight="SemiBold"
                                Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding Guide.DiscoveryOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Content="{Binding Text}"
                                            Margin="0,0,0,8"
                                            Padding="10,8"
                                            HorizontalContentAlignment="Left"
                                            Background="{StaticResource ConversationSendBrush}"
                                            Foreground="White"
                                            BorderBrush="{StaticResource ConversationSendBorderBrush}"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.Guide.SelectDiscoveryOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Guide.DecisionOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Content="{Binding Text}"
                                            Margin="0,0,0,8"
                                            Padding="10,8"
                                            HorizontalContentAlignment="Left"
                                            Background="{StaticResource ConversationSendBrush}"
                                            Foreground="White"
                                            BorderBrush="{StaticResource ConversationSendBorderBrush}"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.Guide.SelectDecisionOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Guide.ActionOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <Button
                                                Padding="10,8"
                                                HorizontalContentAlignment="Left"
                                                Background="{StaticResource ConversationSendBrush}"
                                                Foreground="White"
                                                BorderBrush="{StaticResource ConversationSendBorderBrush}"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.Guide.SelectActionOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                                <TextBlock
                                                    Text="{Binding Label}"
                                                    TextWrapping="Wrap" />
                                            </Button>

                                            <ItemsControl
                                                Margin="10,4,10,0"
                                                ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,1,0,0"
                                                            FontSize="12"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- Workspace -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- Workspace -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
        Margin="20,0"
        Style="{StaticResource CardBorder}">

                <Grid Margin="20,2,20,10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ================================================= -->
                    <!-- SCOUT LIVE REPORT -->
                    <!-- ================================================= -->

                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,14"
                        Padding="12"
                        CornerRadius="10"
                        Background="#F8FAFD"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Operation.HasCollectionItems}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ScrollViewer
                            MaxHeight="520"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            CanContentScroll="True">

                            <StackPanel>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="Live Report"
                                    Margin="0,0,0,10"/>

                                <!-- NEEDS -->
                                <DockPanel
                                    LastChildFill="False"
                                    Margin="0,0,0,4">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasNeedsItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="Bold"
                                        Text="NEEDS"
                                        VerticalAlignment="Center"/>

                                    <Button
                                        DockPanel.Dock="Right"
                                        Margin="12,0,0,0"
                                        Padding="8,2"
                                        Content="Accept All"
                                        Command="{Binding Guide.AcceptAllAsIsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource ConversationSendBrush}"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Operation.HasNeedsItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DockPanel>

                                <ListBox
                                    ItemsSource="{Binding Operation.NeedsItems}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Margin="0,0,0,12"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasNeedsItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="!"
                                                    FontWeight="Bold"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="4,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DisplayName}"/>

                                                <ItemsControl
                                                    Grid.Column="2"
                                                    ItemsSource="{Binding Actions}"
                                                    VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Margin="0,0,8,0"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.Guide.ExecuteProgressActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                                <TextBlock
                                                                    Text="{Binding Label}"
                                                                    TextDecorations="Underline"
                                                                    Foreground="{StaticResource ConversationSendBrush}"/>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- READY FOR ORGANIZATION -->
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Text="READY FOR ORGANIZATION"
                                    Margin="0,4,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasReadyItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox
                                    ItemsSource="{Binding Operation.ReadyItems}"
                                    MaxHeight="190"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Margin="0,0,0,12"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasReadyItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="○" VerticalAlignment="Center"/>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Status}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- WORKING -->
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Text="WORKING"
                                    Margin="0,4,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasWorkingItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox
                                    ItemsSource="{Binding Operation.WorkingItems}"
                                    MaxHeight="190"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Margin="0,0,0,12"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasWorkingItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="●" VerticalAlignment="Center"/>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Status}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- COMPLETE -->
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Text="COMPLETE"
                                    Margin="0,4,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasCompleteItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox
                                    ItemsSource="{Binding Operation.CompleteItems}"
                                    MaxHeight="190"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operation.HasCompleteItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="✓" VerticalAlignment="Center"/>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DisplayName}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================================================= -->
                    <!-- NORMAL MODE -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1">

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger
                            Binding="{Binding Workspace.IsReviewAllActive}"
                            Value="True">
                                        <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <!-- Recommendation -->
                            <RowDefinition Height="Auto"/>

                            <!-- Supporting Evidence - collapses completely when no recommendation exists -->
                            <RowDefinition Height="Auto"/>

                            <!-- Rename Preview heading -->
                            <RowDefinition Height="Auto"/>

                            <!-- Rename Preview - compact verification area -->
                            <RowDefinition Height="110"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                Grid.Row="0"
                FontSize="30"
                FontWeight="Bold"
                Text="Scout's Recommendation">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workspace.SelectedRecommendation}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workspace.SelectedRecommendation}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
        FontSize="20"
        FontWeight="SemiBold"
        Margin="0,0,0,6"
        Text="Supporting Evidence"/>

                            <Border
        Padding="12"
        Background="#EEF5FF"
        CornerRadius="10">

                                <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

                                    <StackPanel>

                                        <TextBlock
                    Text="{Binding Workspace.SelectedObservation.Description}"
                    TextWrapping="Wrap"
                    FontSize="13"
                    Margin="0,0,0,12"/>

                                        <TextBlock
                    Text="{Binding Workspace.SelectedObservation.WhyItMatters}"
                    TextWrapping="Wrap"
                    FontSize="13"
                    Margin="0,0,0,12"/>

                                        <Button
                    Command="{Binding Guide.ExecuteRecommendationActionCommand}"
                    CommandParameter="{Binding Workspace.SelectedRecommendation}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Cursor="Hand">

                                            <TextBlock
                        Text="{Binding Workspace.SelectedRecommendation.ActionText}"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Foreground="#245A35"
                        TextWrapping="Wrap"/>

                                        </Button>

                                    </StackPanel>

                                </ScrollViewer>

                            </Border>

                        </StackPanel>

                        <Grid Grid.Row="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel
                    Grid.Row="0"
                    LastChildFill="False">

                                <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Rename Preview"/>

                                <Border
                        Margin="10,0,0,0"
                        Padding="8,2"
                        Background="#D9EEF8"
                        CornerRadius="10"
                        DockPanel.Dock="Right">

                                    <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Workspace.RenameCount,
                                   StringFormat={}{0} file(s)}"/>

                                </Border>

                            </DockPanel>

                            <Border
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    BorderBrush="#D8D8D8"
                    BorderThickness="1"
                    CornerRadius="8">

                                <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ItemsSource="{Binding Workspace.RenamePreview}">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn
                                Header="Current Name"
                                Width="*"
                                Binding="{Binding CurrentName}"/>

                                        <DataGridTextColumn
                                Header="New Name"
                                Width="*"
                                Binding="{Binding NewName}"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Border>

                        </Grid>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- REVIEW ALL MODE -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger
                            Binding="{Binding Workspace.IsReviewAllActive}"
                            Value="True">
                                        <Setter Property="Visibility"
                                    Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Review All heading -->

                        <TextBlock
                Grid.Row="0"
                FontSize="30"
                FontWeight="Bold"
                Text="Scout's Review All"/>


                        <!-- Introduction -->

                        <Border
                Grid.Row="2"
                Padding="15"
                Background="#EEF5FF"
                CornerRadius="10">

                            <StackPanel>

                                <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Recommendations"/>

                                <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Text="Scout reviewed the discoveries and recommendations from this scan. Nothing will be changed until you choose an action."/>

                                <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding Workspace.ReviewAllItems.Count,
                               StringFormat={}Recommendations found: {0}}"/>

                            </StackPanel>

                        </Border>


                        <!-- Recommendation list -->

                        <Border
                Grid.Row="3"
                Margin="0,15,0,0"
                BorderBrush="#D8D8D8"
                BorderThickness="1"
                CornerRadius="8">

                            <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl
                        ItemsSource="{Binding Workspace.ReviewAllItems}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                    Margin="10"
                                    Padding="15"
                                    Background="#F8FAFD"
                                    BorderBrush="#D8D8D8"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                                <StackPanel>

                                                    <Button
    Padding="0"
    HorizontalContentAlignment="Left"
    Background="Transparent"
    BorderThickness="0"
    Cursor="Hand"
    Command="{Binding DataContext.Workspace.SelectReviewAllItemCommand,
                      RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}">

                                                        <TextBlock
        FontSize="18"
        FontWeight="SemiBold"
        Foreground="#245A35"
        Text="{Binding Recommendation.Title}"
        TextWrapping="Wrap"/>

                                                    </Button>

                                                    <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="13"
                                            Text="{Binding Recommendation.Reason}"
                                            TextWrapping="Wrap"/>

                                                    <ItemsControl
                                            Margin="0,10,0,0"
                                            ItemsSource="{Binding Recommendation.Evidence}">

                                                        <ItemsControl.ItemTemplate>

                                                            <DataTemplate>

                                                                <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="12"
                                                        Text="{Binding}"
                                                        TextWrapping="Wrap"/>

                                                            </DataTemplate>

                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Border>

                    </Grid>

                </Grid>

            </Border>
            <!-- ================================================= -->
            <!-- Scout -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
        Style="{StaticResource CardBorder}">

                <controls:ConversationPanel
DataContext="{Binding Guide}"/>

            </Border>

        </Grid>

    </Grid>

</Window>
